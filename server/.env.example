# Server Configuration
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/crowd_report?replicaSet=rs0
CLIENT_URL=http://localhost:5173

# Authentication Secrets
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_min_32_characters
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_min_32_characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Initial System Admin Seed Credentials
ADMIN_EMAIL=admin@crowdreport.local
ADMIN_PASSWORD=Admin@123456

# SMTP Email Relay Configuration
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_smtp_user_email
SMTP_PASS=your_smtp_password
MAIL_FROM="Crowd Report" <noreply@crowdreport.org>

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# AI Engine (Google Gemini Flash-Lite via Google AI Studio)
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_api_key
AI_MODEL=gemini-1.5-flash-8b
AI_TIMEOUT_MS=4000
AI_DAILY_LIMIT=1000
