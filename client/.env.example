# ==========================================
# Crowd Report Platform - Client Environment
# ==========================================

# Public site domain URL (used for SEO, Canonical tags, Open Graph, and dynamic sitemap.xml)
# Change this when your domain is decided / deployed (e.g. https://crowdreport.in or https://yourdomain.com)
VITE_SITE_URL=http://localhost:5173

# Backend API base URL
# During development: use '/api' to leverage Vite's dev proxy
# In production:
#   - If reverse-proxied (same domain/Nginx): use '/api'
#   - If separate backend domain: use full URL (e.g. 'https://api.yourdomain.com/api' or 'https://your-server.onrender.com/api')
VITE_API_BASE_URL=/api

# Optional: Target server for Vite dev proxy (default: http://localhost:5000)
# Can be changed to a deployed staging backend during local frontend testing
VITE_BACKEND_TARGET=http://localhost:5000
